# ---------------------------------------------------------
# 1. 安定したNode.js最新環境（Debian Bookworm）を土台にする
# ---------------------------------------------------------
FROM node:20-bookworm

# 作業ディレクトリの設定
WORKDIR /app

# エラーの原因になるインタラクティブな確認を完全遮断
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------
# 2. C言語 / C++（長男・次男）のコンパイラだけを確実にインストール
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# 3. 司令塔（JS）の準備とソースの詰め込み
# ---------------------------------------------------------
COPY package*.json ./
RUN npm ci --only=production

# 3人（Py/Ruby/JS）とCブラザーズのファイルを全コピー
COPY . .

# 司令塔のJSを起動（ここからCブラザーズを順番に叩き起こします）
CMD ["node", "js_agent.js"]
